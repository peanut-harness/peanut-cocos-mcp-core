{
    "name": "@peanut/pod-sdk",
    "description": "Author-facing plugin module contracts for Peanut Cocos business plugins.",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "sideEffects": false,
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "tsx --test --tsconfig tsconfig.json tests/plugin-module-base.test.ts"
    },
    "dependencies": {
        "@peanut/pod-protocol": "*"
    },
    "devDependencies": {
        "@types/node": "^24.0.0",
        "tsx": "4.23.0",
        "typescript": "^5.9.3"
    },
    "peanut": {
        "role": "core",
        "verify": true
    }
}
