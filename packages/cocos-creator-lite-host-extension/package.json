{
    "package_version": 2,
    "name": "peanut-pod-lite-host",
    "version": "0.1.0",
    "private": true,
    "main": "./dist/main.js",
    "description": "Native Cocos Creator host for the open Peanut Pod Lite package.",
    "editor": ">=3.8.0 <3.9.0",
    "scripts": {
        "build": "node scripts/pack-host.mjs",
        "pack": "node scripts/pack-host.mjs",
        "test": "npm run pack && node --test tests/release-package.test.mjs tests/package-integrity.test.mts"
    },
    "contributions": {
        "menu": [
            {
                "path": "Extension",
                "label": "Peanut Pod Lite Status",
                "message": "query-status"
            }
        ],
        "messages": {
            "query-status": {
                "methods": [
                    "queryStatus"
                ]
            },
            "list-tools": {
                "methods": [
                    "listTools"
                ]
            },
            "invoke-tool": {
                "methods": [
                    "invokeTool"
                ]
            }
        }
    }
}
