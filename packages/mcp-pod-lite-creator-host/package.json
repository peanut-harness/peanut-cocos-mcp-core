        "pack": "npm run build && node scripts/pack-plugin.mjs"
    },
    "dependencies": {
        "@peanut/pod-lite-capability-policy": "file:../pod-lite-capability-policy"
    },
    "devDependencies": {
        "typescript": "^5.9.3"
    }
}
